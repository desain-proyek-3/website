# =====================================================================
# Dentify — Environment Variables untuk docker-compose.yml
# Copy jadi .env di folder ini (sejajar dengan docker-compose.yml):
#   cp .env.example .env
# lalu isi password dengan nilai asli sebelum `docker compose up -d`.
# =====================================================================

# --- PostgreSQL (pgvector) ---
POSTGRES_USER=dentify_admin
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=dentify_db
POSTGRES_PORT=5432

# --- ChromaDB ---
CHROMA_PORT=8000

# --- MinIO ---
MINIO_ROOT_USER=dentify_minio
MINIO_ROOT_PASSWORD=CHANGE_ME
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
