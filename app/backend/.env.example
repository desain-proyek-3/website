# =====================================================================
# Dentify Backend — Environment Variables
# Copy file ini ke .env dan isi dengan kredensial development lokal.
# JANGAN commit .env ke Git, hanya commit .env.example ini.
# =====================================================================

# ── PostgreSQL ──────────────────────────────────────────────────────
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ── ChromaDB ────────────────────────────────────────────────────────
CHROMA_HOST=localhost
CHROMA_PORT=8001

# ── MinIO ───────────────────────────────────────────────────────────
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_HOST=localhost
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET_NAME=dentify-intraoral-images

# ── AI Microservice ─────────────────────────────────────────────────
AI_SERVICE_BASE_URL=
AI_SERVICE_API_KEY=
AI_SERVICE_TIMEOUT_SECONDS=30.0
AI_SERVICE_POLL_INTERVAL_SECONDS=2.0
AI_SERVICE_MAX_POLL_ATTEMPTS=60

# ── JWT ─────────────────────────────────────────────────────────────
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── Seed admin (dibaca oleh scripts/seed_admin.py) ──────────────────
SEED_ADMIN_PASSWORD=

# ── Application ─────────────────────────────────────────────────────
APP_NAME=Dentify API
APP_VERSION=0.1.0
DEBUG=True

# ── CORS (JSON list origin frontend) ────────────────────────────────
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
