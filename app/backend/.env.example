# =====================================================================
# Dentify Backend — Environment Variables
# Copy file ini ke .env dan isi dengan kredensial development lokal.
# JANGAN commit .env ke Git, hanya commit .env.example ini.
# =====================================================================

# ── PostgreSQL ──────────────────────────────────────────────────────
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ── ChromaDB ────────────────────────────────────────────────────────
CHROMA_HOST=localhost
CHROMA_PORT=8000

# ── MinIO ───────────────────────────────────────────────────────────
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_HOST=localhost
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET_NAME=dentify-intraoral-images

# ── JWT (implementasi di task berikutnya) ───────────────────────────
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── Application ─────────────────────────────────────────────────────
APP_NAME=Dentify API
APP_VERSION=0.1.0
DEBUG=True
