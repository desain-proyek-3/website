# nginx DI DALAM container frontend — hanya file statis hasil build Vite.
# /api, /health, ukuran upload (client_max_body_size) diurus nginx HOST (deploy/nginx-dentify.conf).
# ${FRONTEND_LISTEN} diisi entrypoint nginx dari env saat container start.

server {
    listen ${FRONTEND_LISTEN};
    server_name _;
    server_tokens off;

    root /usr/share/nginx/html;
    index index.html;

    # health check container (tidak diteruskan dari luar)
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # file hasil build ber-hash -> aman di-cache lama
    location /assets/ {
        expires 30d;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # index.html selalu dicek ulang agar redeploy langsung terlihat
    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    location / {
        try_files $uri $uri/ /index.html;   # wajib untuk BrowserRouter
    }
}
